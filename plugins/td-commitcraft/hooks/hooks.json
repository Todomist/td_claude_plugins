{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git checkout -b *)", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/branch-guard.sh\"" },
          { "type": "command", "if": "Bash(git switch -c *)", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/branch-guard.sh\"" }
        ]
      }
    ]
  }
}
